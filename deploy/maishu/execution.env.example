# 执行端 /etc/maishu/execution.env；只填非秘密配置，权限 0600。
# 改为两台 VPS 实际的 Tailscale IPv4；必须属于 100.64.0.0/10。
MAISHU_CONTROLLER_TAIL_IP=100.64.0.10
MAISHU_EXECUTOR_TAIL_IP=100.64.0.20
# 控制端 HTTPS 入口。若仍使用其他私网端口，显式调整此单一端口。
MAISHU_CONTROLLER_PORT=443
# DNS 按客户网络选择；第一项适合使用 Tailscale MagicDNS 的部署。
MAISHU_DOCKER_DNS=100.100.100.100
MAISHU_DOCKER_FALLBACK_DNS=1.1.1.1
