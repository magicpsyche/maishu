# 麦枢控制端。复制到服务器 /etc/maishu/control.env，chmod 600。
NODE_ENV=production
HOST=127.0.0.1
PORT=8797
PUBLIC_BASE_URL=https://console.example.com
CONSOLE_ORIGINS=https://console.example.com
DATABASE_PATH=/var/lib/maishu/maishu.db
AUTH_DATABASE_PATH=/var/lib/maishu/auth.db
FILES_BLOB_DIR=/var/lib/maishu/files
MEMORY_BLOB_DIR=/var/lib/maishu/memory
SESSION_OUTPUTS_DIR=/var/lib/maishu/outputs
CONSOLE_DIR=/opt/maishu/current/apps/console/dist
CONSOLE_BRANDING_DIR=/opt/maishu/current/deploy/maishu/branding
# 分别生成长期随机值，勿把实际密钥提交到仓库。
PLATFORM_ROOT_SECRET=REPLACE_WITH_RANDOM_ROOT_SECRET
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET
API_KEY=REPLACE_WITH_RANDOM_DEPLOYMENT_KEY
PLATFORM_ADMIN_USER_IDS=
MAISHU_PRODUCT=1
# 跨 VPS 工作区收尾可能超过原版 30 秒；不延长 Work 租约或改变重试保护。
MAISHU_WORK_FINALIZATION_REQUEST_TIMEOUT_MS=75000
# 固定任务默认不备份整个工作区；聊天事件、正式产物和记忆分别持久保存。
OMA_WORKSPACE_STRATEGY=ephemeral
# 连续开发任务才按需启用 checkpoint_restore；当前工作区 tar 上限 256 MiB。
# 单控制实例 + OpenSandbox 可用 LocalFs；切换该部署级选项会影响整个实例。
SANDBOX_PROVIDER=opensandbox
OPENSANDBOX_DOMAIN=executor.private:8818
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_API_KEY=REPLACE_WITH_EXECUTION_KEY
OPENSANDBOX_RUNTIME=docker
OPENSANDBOX_MANAGED_BOOTSTRAP=1
SANDBOX_IMAGE=maishu-runtime:2026.11.17
OPENSANDBOX_CPU=2
OPENSANDBOX_MEMORY=4Gi
OPENSANDBOX_TIMEOUT_SECONDS=1800
OPENMA_WORK_RUNNER_COMMAND=/usr/local/bin/node
OPENMA_WORK_RUNNER_ARGS=["/opt/maishu-worker/runner.mjs"]
# 原版兼容变量名；为各后端revision固定版本化只读worker目录。
OPENSANDBOX_VOLUMES=[{"name":"maishu-worker","host":{"path":"/var/lib/maishu/runtime/RELEASE"},"mountPath":"/opt/maishu-worker","readOnly":true}]

# 管理操作调用方等待预算，默认1000ms。跨VPS可按实际延迟选择5000—10000；范围1—89999。
# 只延长调用方等待，不取消底层调用、不改变Work租约或pending single-flight。
# MAISHU_MANAGEMENT_RPC_WAIT_MS=5000
